# Application
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
PORT=4000
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_JOB_MS=900000

# Database
DATABASE_URL=file:./data/app.db

# Local asset storage (must be shared by API + worker)
STORAGE_PATH=./storage

# --- Real cinematic pipeline (text-to-video; not Ken Burns) ---
# Never use MOCK_AI=true for final user-facing MP4s (solid-color placeholders).
MOCK_AI=false
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=pollinations
POLLINATIONS_API_KEY=sk_...   # required — https://enter.pollinations.ai
# POLLINATIONS_VIDEO_MODEL=wan-fast
TTS_PROVIDER=sapi
MUSIC_PROVIDER=mock

# Preferred production stack (requires billing key):
# MOCK_AI=false
# LLM_PROVIDER=openai
# IMAGE_PROVIDER=openai
# VIDEO_PROVIDER=pollinations
# TTS_PROVIDER=openai
# MUSIC_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# --- Mock / CI only (placeholder visuals; not cinematic) ---
# MOCK_AI=true
# LLM_PROVIDER=mock
# IMAGE_PROVIDER=mock
# VIDEO_PROVIDER=mock
# TTS_PROVIDER=mock
# MUSIC_PROVIDER=mock

# Optional: external image/video HTTP instead of Pollinations / Ken Burns
# IMAGE_PROVIDER=local-http
# IMAGE_API_URL=
# IMAGE_API_KEY=
# VIDEO_PROVIDER=wan
# VIDEO_API_BASE_URL=
# VIDEO_API_URL=
# VIDEO_API_KEY=

# Optional Piper TTS
# TTS_PROVIDER=piper
# PIPER_EXECUTABLE=
# PIPER_VOICE=path/to/voice.onnx

# Optional music HTTP (stub until implemented)
# MUSIC_API_URL=

# Worker concurrency
MAX_VIDEO_WORKERS=1
MAX_IMAGE_WORKERS=2
MAX_TTS_WORKERS=2

TARGET_SCENE_DURATION_SEC=8

# Optional: path to ffmpeg binary (uses PATH when unset)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
