{
  "name": "@asv/video-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/test-fixtures.ts\"",
    "pretest": "pnpm --filter @asv/shared build",
    "test": "vitest run"
  },
  "dependencies": {
    "@asv/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "vitest": "^3.2.4"
  }
}
